# ─── Proveedor de modelo ──────────────────────────────────────────────────────
# El ciclo del agente no depende de este valor: lo resuelve src/llm/adapter.ts
LLM_PROVIDER=anthropic              # anthropic | openai | mock
LLM_MODEL=claude-haiku-5-5

# Clave del proveedor. SOLO en el entorno del backend.
# Nunca en el front, nunca en el repositorio, nunca en los logs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Límites de costo y robustez (NFR §8) ─────────────────────────────────────
MAX_ITERACIONES_TURNO=25            # CA1 · tope de ciclos herramienta -> modelo
MAX_TOKENS_SESION=200000            # tope acumulado por sesión
MAX_TOKENS_RESPUESTA=16000          # cubre thinking + texto en una respuesta
LLM_TIMEOUT_MS=60000

# ─── Reglas de negocio ────────────────────────────────────────────────────────
# Fecha contra la que se evalúa `vigencia_hasta` de los soportes (RN3).
# Los fixtures fueron diseñados para una ejecución alrededor de 2026-09-03:
# con esa fecha co-industrias-delta queda listo para firma, hn queda bloqueado
# por parafiscales vencido y ec por soporte ausente.
# Vaciar para usar la fecha actual del sistema.
FECHA_REFERENCIA=2026-09-03

PORT=3000
