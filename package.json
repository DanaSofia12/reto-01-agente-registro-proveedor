{
  "name": "reto-01-agente-registro-proveedor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun --watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "bun src/server.ts",
    "demo": "bun demo.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "modulo": "bun scripts/construir-modulo.ts",
    "modulo:check": "bun scripts/construir-modulo.ts --check",
    "verificar": "bun scripts/verificar-rubrica.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@tailwindcss/vite": "^4.1.16",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
